# Copy this file to .env and edit it for your machine:
#   cp .env.example .env

# ── Paths on the host ────────────────────────────────────────────────────────
# Host directories are mounted at the SAME path inside the container, so the
# folder picker browses your real filesystem and datasets can live anywhere.
# You do NOT list individual datasets here — only the broad roots to expose.
HOME_MOUNT=/home
MNT_MOUNT=/mnt
# Removable/auxiliary drives. On this machine the working disk is here
# (e.g. /media/<user>/<disk>/datasets/...), so it must be mounted.
MEDIA_MOUNT=/media

# Your own home directory. This is what the picker's Home/Desktop buttons use.
# REQUIRED in practice — without it $HOME falls back to a container-internal
# directory and the picker's Home/Desktop buttons point nowhere useful.
HOST_HOME=/home/<your-user>

# Default output directory for new runs. Must sit under one of the mounts above.
RUNS_DIR=/home/<your-user>/trainstudio-runs

# Optional pinned shortcut buttons in the picker, colon-separated.
# QUICK_DIRS=/mnt/nas/datasets:/home/<your-user>/projects
QUICK_DIRS=

# ── File ownership ───────────────────────────────────────────────────────────
# Files written to RUNS_DIR are created with this UID/GID. Set them to your own
# user so the checkpoints are not owned by root: run `id -u` and `id -g`.
PUID=1000
PGID=1000
TZ=UTC

# ── Network ──────────────────────────────────────────────────────────────────
# 127.0.0.1 keeps the app reachable only from the workstation itself: from any
# other machine the port answers "connection refused" even though the app is
# running fine on localhost. Set 0.0.0.0 to expose it on the LAN — preferably
# behind the proxy profile, since Streamlit has no authentication and the folder
# picker can browse every mounted path on this host.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8501
# This machine's address as a remote browser types it. Current Streamlit opens
# its WebSocket relative to the page's own origin, so a remote browser works
# even when this is wrong; what breaks is the URL Streamlit logs at startup and
# anything that needs an absolute link. Set it anyway when not on localhost.
PUBLIC_HOSTNAME=localhost
MAX_UPLOAD_MB=2048

# ── GPU ──────────────────────────────────────────────────────────────────────
# How many GPUs to reserve: 1, 2, … or "all". To pin one specific card instead,
# edit the `devices:` block in docker-compose.yml to `device_ids: ["1"]`.
GPU_COUNT=1

# ── Resources ────────────────────────────────────────────────────────────────
# Shared memory for the DataLoader workers. Docker's 64MB default is far too
# small and surfaces as an opaque "bus error" mid-epoch. Raise it if you train
# 3D volumes with many workers.
SHM_SIZE=16gb
# Keep this below your core count so the data pipeline still has room.
OMP_NUM_THREADS=8
MKL_NUM_THREADS=8

# ── Build ────────────────────────────────────────────────────────────────────
# CUDA 12.4 covers driver 550+. For an older driver switch to cu121, for a
# Blackwell card to cu128 — adjust the base image to match.
CUDA_IMAGE=nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124
TORCH_VERSION=2.5.1
TORCHVISION_VERSION=0.20.1
TAG=latest

# ── Reverse proxy (the `proxy` profile) ──────────────────────────────────────
PROXY_PORT=8080
BASIC_AUTH_USER=team
# Set both with:  ./scripts/set_proxy_password.sh
#
# Do NOT paste a hash here by hand unless you double every `$`. Compose
# interpolates `$`-sequences when it reads this file, so a bcrypt hash pasted
# verbatim arrives at Caddy with `$2y$12$eNxx` collapsed to `$2y$12` — still a
# plausible looking string, so nothing errors: the proxy starts, shows the login
# box and rejects every password, with no clue in any log. Written doubled
# (`$$2y$$12$$eNxx`) Compose collapses it back to the real hash.
BASIC_AUTH_HASH=

# Set to `proxy` to start the proxy alongside the app, so `docker compose up -d`
# and `make up` bring both. Leave empty to run the app alone on HOST_PORT.
COMPOSE_PROFILES=
